# Copiar a .env y completar con valores reales (nunca commitear .env)
ENVIRONMENT=development
PROJECT_NAME=RutaVivaMythF

# Base de datos
# ---
# Opción A (RECOMENDADA — paridad total con prod, levantá con: docker compose up -d):
DATABASE_URL=mysql+pymysql://rutaviva:rutaviva_dev@localhost:3306/rutaviva
#
# Opción B (sin Docker, ultra rápido para contribuir algo chico):
# DATABASE_URL=sqlite:///./rutaviva.db
#
# Opción C (Hostinger MySQL remoto — activar Remote MySQL y whitelistear IP):
# DATABASE_URL=mysql+pymysql://USUARIO:PASSWORD@srv1234.hstgr.io:3306/NOMBRE_BD

# Seguridad (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,https://rutaviva.mythf.site

# APIs públicas gratuitas (no requieren key)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
GEOREF_URL=https://apis.datos.gob.ar/georef/api/v2
OSRM_URL=https://router.project-osrm.org
DATOS_GOB_URL=https://datos.gob.ar/api/3/action

# Admin bootstrap (el backend crea este user admin en el primer arranque si no existe)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-10-chars
ADMIN_FULL_NAME=Admin

# Web Push (VAPID keys — generar con: python generate_vapid_keys.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
